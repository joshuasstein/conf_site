DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/conf_site
SECRET_KEY=change-me-to-a-long-random-string

# Postmark (email sending) — https://postmarkapp.com
POSTMARK_API_TOKEN=your-postmark-server-api-token
# Message stream to send on (default "outbound" = the transactional stream)
POSTMARK_MESSAGE_STREAM=outbound

S3_BUCKET_NAME=your-bucket-name
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=auto

# Database backups (scripts/backup_db.py) — see docs/BACKUPS.md.
# MUST be a SEPARATE bucket from S3_BUCKET_NAME so an admin data-reset can't wipe backups.
BACKUP_S3_BUCKET_NAME=your-backup-bucket-name
BACKUP_RETENTION_DAYS=30

FRONTEND_URL=http://localhost:3000
